    var clickTop = clickY - wallRect.top - wall.clientTop;
    var spiderLeft = clickLeft - spiderWidth / 2;
    var spiderTop = clickTop - spiderHeight / 2;
    var maxLeft = Math.max(0, wall.clientWidth - spiderWidth);
    var maxTop = Math.max(0, wall.clientHeight - spiderHeight);
